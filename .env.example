# QSYSRadio server configuration: copy to .env in the app directory.
# .env is gitignored and never committed; keep it chmod 600 (it holds the DB
# password). systemd loads it via EnvironmentFile=, and the CLI tools
# (python -m server.migrate) read it directly. Restart after editing:
#   sudo systemctl restart qsysradio
#
# Format: KEY=value, one per line, no spaces around '='. Lines starting with
# # are comments. No inline comments and no $VAR expansion.

# ── Flask session signing key (install.sh generates this) ────────────────────
SECRET_KEY=

# ── PostgreSQL (required) ────────────────────────────────────────────────────
# Use the same database as 321Theater and the other apps; QSYSRadio keeps all
# of its tables in its own schema (PG_APP_SCHEMA). It creates the schema on
# first start only if PG_USER has CREATE on the database; otherwise a DBA
# creates it first. Role and grants: README, Installation, step 2.
# PG_HOST: host name or IP; localhost when PostgreSQL is on this machine.
# A socket directory (/var/run/postgresql) works only with a pg_hba.conf
# `local` line using scram-sha-256 for this role (Debian's default is `peer`,
# which refuses it: "Peer authentication failed").
PG_HOST=localhost
# PG_PORT: the same port 321Theater uses (its .env's PG_PORT; usually 5432).
PG_PORT=5432
PG_DBNAME=321theater
PG_USER=qsysradio
PG_PASSWORD=
# app schema = radio data. shared schema = 321Theater's (must match its
# PG_SHARED_SCHEMA): users is read, app_sessions is read and written (sign-in).
PG_APP_SCHEMA=qsysradio
PG_SHARED_SCHEMA=shared

# Time zone for reading/writing play log times (from/to without an offset,
# and SQL you run through the app). Empty = the PostgreSQL server's zone.
#TIMEZONE=America/New_York

# ── Web server ───────────────────────────────────────────────────────────────
# The Core and staff browsers reach this server at http://<this server>:APP_PORT
# (plain HTTP, all interfaces).
APP_PORT=5410
# gunicorn processes x threads = requests served at once (default 4 x 8).
# Each worker opens up to WEB_THREADS + 2 PostgreSQL connections.
# Background jobs never assume a single worker: they take a PG advisory lock.
#WEB_WORKERS=4
#WEB_THREADS=8
# 1 = log every request to the journal (the Core alone makes one a second).
#ACCESS_LOG=1
# Idle database connections each worker keeps for reuse (default 4).
#PG_POOL_MAX_IDLE=4

# ── The Core's link to this server ───────────────────────────────────────────
# Shared secret the Core sends as X-Radio-Token: put the same value in
# radio.lua as CFG.SERVER_TOKEN. install.sh generates it. Required: without it
# the Core's endpoints refuse every request (RADIO_ALLOW_NO_TOKEN=1 lifts that
# for a lab setup; anyone who can reach the port could then post as the Core).
RADIO_API_TOKEN=
#RADIO_ALLOW_NO_TOKEN=1

# ── Sign-in cookie (optional) ────────────────────────────────────────────────
# The `session` cookie is shared with the sister apps on the same host name.
# 1 only when people reach this server through an HTTPS reverse proxy.
#SESSION_COOKIE_SECURE=1
# Leave unset unless every sister app sets the same domain (321Theater does not).
#SESSION_COOKIE_DOMAIN=.example.org

# ── Remote syslog (optional) ─────────────────────────────────────────────────
# Every play, end, unsupported file, dead-air guard, Core restart and server
# error is also sent here. Easiest: set it on the Settings page (Server
# settings), which overrides these; these are only the defaults. Empty
# SYSLOG_HOST = journald only.
#SYSLOG_HOST=10.0.0.5
#SYSLOG_PORT=514
# udp | tcp
#SYSLOG_PROTOCOL=udp
# rfc3164 (BSD, "Mmm dd hh:mm:ss host QSYSRadio[pid]: ...") | rfc5424
#SYSLOG_FORMAT=rfc3164
# kern, user, daemon, local0 ... local7
#SYSLOG_FACILITY=local0
# DEBUG | INFO | WARNING | ERROR
#SYSLOG_LEVEL=INFO
#SYSLOG_APP_NAME=QSYSRadio
